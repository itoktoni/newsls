<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- ponytail: <env> SENDIRIAN TIDAK CUKUP di mesin ini, WAJIB dipasangkan <server>.
             1) phpdotenv membaca $_SERVER lebih dulu:
                vendor/vlucas/phpdotenv/src/Repository/RepositoryBuilder.php:25
                DEFAULT_ADAPTERS = [ServerConstAdapter, EnvConstAdapter].
             2) <env> phpunit hanya menulis $_ENV + putenv, BUKAN $_SERVER
                (vendor/phpunit/phpunit/src/TextUI/Configuration/PhpHandler.php:132),
                sedangkan <server> menulis $_SERVER tanpa syarat (PhpHandler.php:125).
             3) ImmutableWriter phpdotenv tetap menulis nilai .env ke $_SERVER yang belum ter-set,
                jadi .env (DB_CONNECTION=mariadb, DB_DATABASE=bka) menang atas <env force="true">.
             Kontrak awal: sqlite :memory:. Sekarang sesuai request: isolated MariaDB test_bka
             (bukan bka produksi, bukan :memory:). test_bka di-create IF NOT EXISTS sebelum suite.
             RefreshDatabase akan migrate:fresh HANYA di test_bka, aman.
             Regresi dijaga tests/Feature/TestingEnvironmentTest.php (cek mariadb/test_bka). -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="mariadb" force="true"/>
        <env name="DB_DATABASE" value="test_bka" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_USERNAME" value="root" force="true"/>
        <env name="DB_PASSWORD" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>

        <!-- Cermin dari <env> di atas: inilah yang benar-benar dipakai (dibaca $_SERVER). -->
        <server name="APP_ENV" value="testing"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <server name="CACHE_STORE" value="array"/>
        <server name="DB_CONNECTION" value="mariadb"/>
        <server name="DB_DATABASE" value="test_bka"/>
        <server name="DB_URL" value=""/>
        <server name="DB_HOST" value="127.0.0.1"/>
        <server name="DB_PORT" value="3306"/>
        <server name="DB_USERNAME" value="root"/>
        <server name="DB_PASSWORD" value=""/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="PULSE_ENABLED" value="false"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
